# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored. Real environment variables override it.

ConnectionStrings__Default=Host=localhost;Port=5432;Database=SchoolAdmission;Username=postgres;Password=<your-password>

# How long a seat stays HELD before it expires (seconds). Use 30 to test expiry quickly.
HOLD_DURATION_SECONDS=600
